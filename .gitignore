# Visual Studio 2015 user specific files
breakingStuffGame/.vscode/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
breakingStuffGame/SourceArt/**/*.png
SbreakingStuffGame/ourceArt/**/*.tga

# Binary Files
breakingStuffGame/Binaries/*
breakingStuffGame/Plugins/*/Binaries/*

# Builds
breakingStuffGame/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
breakingStuffGame/!Build/*/
breakingStuffGame/Build/*/**
breakingStuffGame/!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
breakingStuffGame/!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
breakingStuffGame/Saved/*

# Compiled source files for the engine to use
breakingStuffGame/Intermediate/*
breakingStuffGame/Plugins/*/Intermediate/*

# Cache files for the editor to use
breakingStuffGame/DerivedDataCache/*
