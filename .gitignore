# Visual Studio 2015 user specific files
breakingStuffProject/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
breakingStuffProject/SourceArt/**/*.png
breakingStuffProject/SourceArt/**/*.tga

# Binary Files
breakingStuffProject/Binaries/*
breakingStuffProject/Plugins/*/Binaries/*

# Builds
breakingStuffProject/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
breakingStuffProject/!Build/*/
breakingStuffProject/Build/*/**
breakingStuffProject/!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
breakingStuffProject/!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
breakingStuffProject/Saved/*

# Compiled source files for the engine to use
breakingStuffProject/Intermediate/*
breakingStuffProject/Plugins/*/Intermediate/*

# Cache files for the editor to use
breakingStuffProject/DerivedDataCache/*
